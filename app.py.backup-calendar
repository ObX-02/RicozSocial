def log_activity(
    user_id,
    action,
    entity_type=None,
    entity_id=None,
    description=None,
    brand_id=None
):

    conn = get_db_connection()

    try:

        with conn.cursor() as cur:

            cur.execute("""
                INSERT INTO activity_logs (
                    user_id,
                    brand_id,
                    action,
                    entity_type,
                    entity_id,
                    description,
                    ip_address
                )
                VALUES (
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s
                )
            """, (
                user_id,
                brand_id,
                action,
                entity_type,
                entity_id,
                description,
                request.remote_addr
            ))

        conn.commit()

    finally:
        conn.close()


