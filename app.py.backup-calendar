            url_for("publisher")
        )

    if len(title) > 255:

        flash(
            "Post title is too long.",
            "danger"
        )

        return redirect(
            url_for("publisher")
        )

    if status not in POST_STATUSES:

        flash(
            "Invalid post status.",
            "danger"
        )

        return redirect(
            url_for("publisher")
        )

    if status == "scheduled" and not scheduled_at_raw:

        flash(
            "Please select a schedule date and time.",
            "danger"
        )

        return redirect(
            url_for("publisher")
        )

    # -----------------------------------------------------
    # DATE/TIME
    # -----------------------------------------------------

    scheduled_at = None

    if scheduled_at_raw:

        try:

            scheduled_at = datetime.fromisoformat(
                scheduled_at_raw
            )

        except ValueError:

            flash(
                "Invalid schedule date and time.",
                "danger"
            )

            return redirect(
                url_for("publisher")
            )

    if status == "draft":

        scheduled_at = None

    # -----------------------------------------------------
    # DATABASE
    # -----------------------------------------------------

    conn = get_db_connection()

    try:

        with conn.cursor() as cur:

            # ---------------------------------------------
            # BRAND VALIDATION
            # ---------------------------------------------

            cur.execute("""
                SELECT
                    id,
                    name,
                    is_active
                FROM brands
                WHERE id = %s
            """, (brand_id,))

            brand = cur.fetchone()

            if not brand:

                flash(
                    "Selected brand does not exist.",
                    "danger"
                )

                return redirect(
                    url_for("publisher")
                )

            if not brand["is_active"]:

                flash(
                    "Posts cannot be created for an inactive brand.",
                    "danger"
                )

                return redirect(
                    url_for("publisher")
                )

            # ---------------------------------------------
            # ACCOUNT VALIDATION
            # ---------------------------------------------

            valid_accounts = []

            if account_ids:

                cur.execute("""
                    SELECT
                        sa.id,
                        sa.brand_id,
                        sa.platform,
                        sa.account_name
                    FROM social_accounts sa
                    WHERE sa.id = ANY(%s)
                    AND sa.brand_id = %s
                    AND sa.is_connected = TRUE
                """, (
                    account_ids,
                    brand_id
                ))

                valid_accounts = cur.fetchall()

                if len(valid_accounts) != len(account_ids):

                    flash(
                        "One or more selected social accounts are invalid, disconnected, or belong to another brand.",
                        "danger"
                    )

                    return redirect(
                        url_for("publisher")
                    )

            # ---------------------------------------------
            # CREATE POST
            # ---------------------------------------------

            cur.execute("""
                INSERT INTO posts (
                    brand_id,
                    created_by,
                    title,
                    content,
                    media_url,
                    status,
                    scheduled_at
                )
                VALUES (
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s
                )
                RETURNING id
            """, (
                brand_id,
                user["id"],
                title or None,
                content,
                media_url or None,
                status,
                scheduled_at
            ))

            post_id = cur.fetchone()["id"]

            # ---------------------------------------------
            # CONNECT POST TO ACCOUNTS
            # ---------------------------------------------

            for account in valid_accounts:

                cur.execute("""
                    INSERT INTO post_platforms (
                        post_id,
                        social_account_id,
                        platform_status
                    )
                    VALUES (
                        %s,
                        %s,
                        'pending'
                    )
                    ON CONFLICT (
                        post_id,
                        social_account_id
                    )
                    DO NOTHING
                """, (
                    post_id,
                    account["id"]
                ))

        conn.commit()

    finally:
        conn.close()

    # -----------------------------------------------------
    # ACTIVITY
    # -----------------------------------------------------

    log_activity(
        user["id"],
        "create",
        "post",
        post_id,
        f"Created post: {title or 'Untitled post'}",
        brand_id
    )

    # -----------------------------------------------------
    # NOTIFICATION
    # -----------------------------------------------------

    conn = get_db_connection()

    try:

        with conn.cursor() as cur:

            notification_title = (
                "Post scheduled"
                if status == "scheduled"
                else "Draft created"
            )

            notification_message = (
                f"{title or 'Untitled post'} "
                f"for {brand['name']}"
            )

            cur.execute("""
                INSERT INTO notifications (
                    user_id,
                    title,
                    message,
                    notification_type
                )
                VALUES (
                    %s,
                    %s,
                    %s,
                    'publisher'
                )
            """, (
                user["id"],
                notification_title,
                notification_message
            ))

        conn.commit()

    finally:
        conn.close()

    flash(
        (
            "Post scheduled successfully."
            if status == "scheduled"
            else "Post saved successfully."
        ),
        "success"
    )

    return redirect(
        url_for("publisher")
    )


